++++		case 2: // Instant win
++++			target_char_id = market->buyer_id; // Try buyer's map first
++++			break;
++++		case 1: // No bidders
++++		case 3: // Cancelled
++++		case 5: // Reg failure
++++			target_char_id = market->seller_id;
++++			break;
++++		case 4: // Outbid
++++			target_char_id = market->buyer_id;
++++			break;
++++	}
++++
++++	if (map_charid2sd(target_char_id) != nullptr)
++++		is_responsible = true;
++++	else if (other_mapserver_count == 0) // Only map server
++++		is_responsible = true;
